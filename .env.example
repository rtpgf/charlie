# Copy to .env and adjust. .env is gitignored.

# HTTP server
PORT=3000
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

# Alexa request signature + timestamp verification.
# MUST be true for any endpoint Amazon can reach (including tunnels).
# Set to false only for local curl testing with handcrafted request JSON.
ALEXA_VERIFY_REQUESTS=true

# Optional. Your skill's Application ID from the Alexa Developer Console,
# e.g. amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# When set, requests from any other skill are rejected.
ALEXA_SKILL_ID=
