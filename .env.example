# Copy to .env and adjust. .env is gitignored.

# HTTP server
PORT=3000
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

# Postgres connection string. Supabase, or any Postgres.
# Use the direct connection (port 5432), not the transaction pooler.
# If you hit a self-signed certificate error, change sslmode=require to
# sslmode=no-verify.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Your Alexa userId, mapped to the seeded household by `npm run db:seed`.
# Obtain it by asking Charlie a family question and reading the server log --
# see README "Alexa user mapping". Kept here so no real account id is committed.
DEV_ALEXA_USER_ID=

# --- WhatsApp (Meta Cloud API) ---
# Optional: Charlie's Alexa features work without any of these. The webhook
# endpoints return 503 until the two security values are set.

# Any string you choose. Must match what you enter in the Meta App Dashboard
# when subscribing the webhook. Used only for the setup challenge.
WHATSAPP_VERIFY_TOKEN=

# App secret from Meta App Dashboard -> App settings -> Basic.
# Every inbound webhook is HMAC-verified against this. Required to receive.
WHATSAPP_APP_SECRET=

# Access token from WhatsApp -> API Setup. Required to send acknowledgments.
WHATSAPP_ACCESS_TOKEN=

# Phone number ID (not the phone number) from WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Graph API version used for outbound calls. Pinned here because Meta ships new
# versions often and each stays usable for about two years.
WHATSAPP_GRAPH_API_VERSION=v26.0

# Your WhatsApp number, mapped to Jenna by `npm run db:seed`.
# Digits only or +1 style; both normalize the same way.
DEV_WHATSAPP_SENDER_ID=

# --- AI knowledge extraction ---
# Optional: Alexa (M1/M2) and WhatsApp transport (M3) work without it.
# Without a key, messages are still stored verbatim and can be reprocessed later.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Thinking depth for extraction: low | medium | high.
# Extraction is a small task; low keeps webhook handling prompt.
AI_EFFORT=low

# Rephrase multi-event Alexa answers with the model. Off by default: it adds a
# model call to the one surface where someone is waiting for the Echo to speak.
# Single-event and empty answers never call it. The deterministic sentence is
# always built first and is used whenever the rewrite fails validation.
AI_NARRATE_AGENDA=false

# --- Supabase Storage for group photos ---
# A PRIVATE bucket. Photos are only ever reachable through short-lived signed
# URLs; Charlie never generates a permanent or public URL.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=group-media

# Photos are served from Charlie's own domain, not straight from storage: an
# Echo Show will not load a 550-character Supabase signed URL, but loads a short
# path on the host it already reaches Charlie through. Leave both unset and
# Alexa falls back to storage's signed URL, which works everywhere but a device.
# The secret signs those links; rotating it revokes every outstanding one.
#   openssl rand -base64 32
PUBLIC_BASE_URL=https://charlie.example.com
MEDIA_LINK_SECRET=

# How Charlie acknowledges a message, without replying in the thread.
# Defaults: thumbs-up when saved, warning mark when received but not saved.
MESSAGING_REACTION_SAVED=👍
MESSAGING_REACTION_PROBLEM=⚠️

# Alexa request signature + timestamp verification.
# MUST be true for any endpoint Amazon can reach (including tunnels).
# Set to false only for local curl testing with handcrafted request JSON.
ALEXA_VERIFY_REQUESTS=true

# Optional. Your skill's Application ID from the Alexa Developer Console,
# e.g. amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# When set, requests from any other skill are rejected.
ALEXA_SKILL_ID=
